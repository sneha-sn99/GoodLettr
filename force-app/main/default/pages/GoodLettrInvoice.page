<apex:page standardController="Order" extensions="GoodLettrInvoiceController"
           renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false"
           sidebar="false" standardStylesheets="false">
<html>
<head>
<style type="text/css">
    @page {
        size: A4;
        margin: 22mm 18mm 22mm 18mm;
        @bottom-left { content: "{!legalName} - Invoice {!invoiceNumber}"; font-family: sans-serif; font-size: 8pt; color: #6b7280; }
        @bottom-right { content: "Page " counter(page) " of " counter(pages); font-family: sans-serif; font-size: 8pt; color: #6b7280; }
    }
    body { font-family: sans-serif; font-size: 9.5pt; color: #1f2937; line-height: 1.4; }
    .brand { font-size: 22pt; font-weight: bold; color: #1e3a8a; }
    .muted { color: #6b7280; }
    h1 { font-size: 20pt; color: #1e3a8a; margin: 18px 0 4px 0; }
    h2 { font-size: 11pt; color: #1e3a8a; border-bottom: 1px solid #c7d2fe; padding-bottom: 3px; margin: 18px 0 8px 0; }
    table { width: 100%; border-collapse: collapse; }
    .meta td { padding: 2px 0; vertical-align: top; }
    .parties td { width: 50%; vertical-align: top; padding: 8px 10px; border: 1px solid #e5e7eb; }
    .lines th { background: #1e3a8a; color: #ffffff; font-size: 8.5pt; text-align: left; padding: 6px; }
    .lines td { border-bottom: 1px solid #e5e7eb; padding: 6px; font-size: 9pt; vertical-align: top; }
    .num { text-align: right; }
    .total td { font-weight: bold; font-size: 11pt; border-top: 2px solid #1e3a8a; border-bottom: none; }
    .due { background: #eef2ff; border: 1px solid #c7d2fe; padding: 10px 12px; margin-top: 14px; }
</style>
</head>
<body>
<table>
    <tr>
        <td><div class="brand">GoodLettr</div><div class="muted">Tenancy Management Software</div></td>
        <td style="text-align:right;">
            <div style="font-size:16pt; font-weight:bold; color:#1e3a8a;">INVOICE</div>
            <div class="muted">No. <strong>{!invoiceNumber}</strong></div>
        </td>
    </tr>
</table>

<h2>Details</h2>
<table class="meta">
    <tr><td style="width:35%;" class="muted">Invoice date</td><td><apex:outputText value="{0,date,dd MMMM yyyy}"><apex:param value="{!invoiceDate}"/></apex:outputText></td></tr>
    <tr><td class="muted">Due date</td><td><strong><apex:outputText value="{0,date,dd MMMM yyyy}"><apex:param value="{!dueDate}"/></apex:outputText></strong> (30 days)</td></tr>
    <tr><td class="muted">Billing period</td><td>{!billingFrequency}:&nbsp;<apex:outputText value="{0,date,dd MMM yyyy}"><apex:param value="{!periodStart}"/></apex:outputText>&nbsp;to&nbsp;<apex:outputText value="{0,date,dd MMM yyyy}"><apex:param value="{!periodEnd}"/></apex:outputText></td></tr>
    <tr><td class="muted">Order</td><td>{!ord.OrderNumber}</td></tr>
    <tr><td class="muted">Contract</td><td>{!ord.Service_Contract__r.Name}</td></tr>
</table>

<table class="parties" style="margin-top:12px;">
    <tr>
        <td>
            <strong>From</strong><br/>
            {!legalName}<br/>
            {!registeredAddress}<br/>
            Company no. {!companyNumber}
        </td>
        <td>
            <strong>Bill to</strong><br/>
            {!ord.Account.Name}<br/>
            <apex:outputText rendered="{!NOT(ISBLANK(ord.BillToContact.Name))}">Attention: {!ord.BillToContact.Name}<br/></apex:outputText>
            <apex:outputText rendered="{!NOT(ISBLANK(ord.BillingStreet))}">{!ord.BillingStreet}<br/></apex:outputText>
            <apex:outputText rendered="{!NOT(ISBLANK(ord.BillingCity))}">{!ord.BillingCity}&nbsp;{!ord.BillingPostalCode}<br/></apex:outputText>
            <apex:outputText rendered="{!NOT(ISBLANK(ord.BillingCountry))}">{!ord.BillingCountry}</apex:outputText>
        </td>
    </tr>
</table>

<h2>Charges</h2>
<table class="lines">
    <tr>
        <th style="width:34%;">Description</th>
        <th class="num">Tenancies</th>
        <th class="num">Rate / tenancy / month</th>
        <th class="num">Discount</th>
        <th class="num">Price / tenancy / period</th>
        <th class="num">Amount</th>
    </tr>
    <apex:repeat value="{!lines}" var="li">
    <tr>
        <td><strong>{!li.Product2.Name}</strong><br/><span class="muted">{!BLANKVALUE(li.Billing_Frequency__c, 'Monthly')} usage charge</span></td>
        <td class="num"><apex:outputText value="{0,number,#,##0}"><apex:param value="{!li.Quantity}"/></apex:outputText></td>
        <td class="num"><apex:outputText value="£{0,number,#,##0.00}"><apex:param value="{!li.ListPrice}"/></apex:outputText></td>
        <td class="num"><apex:outputText value="{0,number,0.##}%" rendered="{!NOT(ISNULL(li.Discount_Percent__c))}"><apex:param value="{!li.Discount_Percent__c}"/></apex:outputText><apex:outputText value="-" rendered="{!ISNULL(li.Discount_Percent__c)}"/></td>
        <td class="num"><apex:outputText value="£{0,number,#,##0.00}"><apex:param value="{!li.UnitPrice}"/></apex:outputText></td>
        <td class="num"><apex:outputText value="£{0,number,#,##0.00}"><apex:param value="{!li.TotalPrice}"/></apex:outputText></td>
    </tr>
    </apex:repeat>
    <tr class="total">
        <td colspan="5">Total due</td>
        <td class="num"><apex:outputText value="£{0,number,#,##0.00}"><apex:param value="{!ord.TotalAmount}"/></apex:outputText></td>
    </tr>
</table>

<div class="due">
    <strong>Payment terms:</strong> payable within 30 days of the invoice date, by&nbsp;<apex:outputText value="{0,date,dd MMMM yyyy}"><apex:param value="{!dueDate}"/></apex:outputText>.
    Please quote invoice number <strong>{!invoiceNumber}</strong> with your payment.
</div>
<p class="muted" style="font-size:8.5pt; margin-top:12px;">
    Charges are for tenancies managed through GoodLettr Tenancy Management Software during the billing period,
    as set out in your GoodLettr Software Services Agreement.
</p>
</body>
</html>
</apex:page>