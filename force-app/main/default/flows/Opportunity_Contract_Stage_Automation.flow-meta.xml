<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Negotiation_Review</name>
        <label>Set Negotiation/Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Negotiation/Review</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Proposal_Price_Quote</name>
        <label>Set Proposal/Price Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Proposal/Price Quote</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Which_Contract_Event</name>
        <label>Which Contract Event?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No stage change</defaultConnectorLabel>
        <rules>
            <name>Contract_Sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fContractSent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Negotiation_Review</targetReference>
            </connector>
            <label>Contract Sent</label>
        </rules>
        <rules>
            <name>Contract_Generated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fContractGenerated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Proposal_Price_Quote</targetReference>
            </connector>
            <label>Contract Generated</label>
        </rules>
    </decisions>
    <description>Before-save on Opportunity update. Moves the stage when the contract quick actions stamp the Opportunity:
- Contract Sent On changed (Send Contract Email) -&gt; Negotiation/Review
- Contract Generated On changed (Generate Contract PDF) -&gt; Proposal/Price Quote, unless already at Proposal/Price Quote or Negotiation/Review
Never moves a closed Opportunity.</description>
    <formulas>
        <description>Contract generated on an open Opportunity that is not already at/after Proposal/Price Quote.</description>
        <name>fContractGenerated</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Contract_Generated_On__c}), NOT(ISBLANK({!$Record.Contract_Generated_On__c})), NOT({!$Record.IsClosed}), TEXT({!$Record.StageName}) &lt;&gt; &quot;Proposal/Price Quote&quot;, TEXT({!$Record.StageName}) &lt;&gt; &quot;Negotiation/Review&quot;)</expression>
    </formulas>
    <formulas>
        <description>Email sent on an open Opportunity.</description>
        <name>fContractSent</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Contract_Sent_On__c}), NOT(ISBLANK({!$Record.Contract_Sent_On__c})), NOT({!$Record.IsClosed}))</expression>
    </formulas>
    <interviewLabel>Opportunity Contract Stage Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Contract Stage Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Which_Contract_Event</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
