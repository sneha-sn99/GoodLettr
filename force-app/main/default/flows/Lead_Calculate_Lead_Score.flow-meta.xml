    <actionCalls>
        <description>Flow formulas cannot reference line-break characters, so line breaks and tabs are replaced with spaces in Apex before phrase matching.</description>
        <name>Remove_Line_Breaks</name>
        <label>Remove Line Breaks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>GoodLettrTextCleaner</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_Active_Rules</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
